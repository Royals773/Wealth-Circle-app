# Copy this file to .env.local and fill in real values from your Supabase
# project settings (Project Settings -> API). Never commit .env.local or
# any file containing real secrets — .gitignore already excludes .env*.
#
# The public marketing site, and every page's structural preview, render
# without any of these being set. They are only required to exercise real
# sign-up/sign-in, onboarding, invitations, and the dashboard against a
# live backend.
#
# WealthCircle's Supabase project must be its own, dedicated project —
# do not reuse credentials from any other project.

# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings -> API -> Project API keys -> Publishable key
# (older Supabase projects call this the "anon" key — same purpose).
# Safe to expose to the browser. Row Level Security is what actually
# protects data behind this key — see docs/security-boundaries.md.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The public URL this app is deployed at (used to build auth redirect
# links such as email confirmation and password reset). This exact value,
# with /auth/callback and /auth/confirm appended, must also be added to
# your Supabase project's Auth -> URL Configuration -> Redirect URLs.
# For local development:
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Project Settings -> API -> Project API keys -> Secret key
# (older Supabase projects call this the "service_role" key — same
# purpose: it bypasses Row Level Security entirely).
# SERVER-ONLY. Never reference this from a client component or anything
# bundled into browser code. NOT required or used anywhere in Phase 1 or
# Phase 2 — every feature so far works through RLS-respecting clients and
# narrowly-scoped SECURITY DEFINER database functions instead. Leave this
# blank unless a future, genuinely backend-only feature needs it.
SUPABASE_SECRET_KEY=

# Generic SMTP relay for notification emails (contribution/loan/
# withdrawal/governance/membership events) — provider-agnostic, since
# nodemailer speaks plain SMTP. For local development, point this at
# Mailtrap's Email Testing sandbox (see docs/security-boundaries.md);
# never point Mailtrap credentials at a real inbox. For production, use
# a real transactional email provider's SMTP credentials instead — this
# is a deliberate, separately-approved decision (see
# docs/phase-9-deployment-checklist.md), not something to change
# casually. Leave blank to disable email sending entirely — every
# notification still appears in-app regardless.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_SMTP_FROM_EMAIL=

# Phase 9: authenticates the scheduled-job trigger endpoint
# (/api/scheduler/run), which fires the reminder/expiry functions and
# flushes queued notification emails on a schedule. SCHEDULER_SECRET is
# a long random string the external scheduler sends as a bearer token —
# distinct from and no more powerful than SUPABASE_SECRET_KEY, since it
# only gates this one HTTP endpoint, not database access.
# SCHEDULER_SUPABASE_EMAIL/PASSWORD belong to a dedicated, ordinary
# Supabase Auth account with no group memberships, which the endpoint
# signs in as to call the already-authenticated-granted reminder RPCs —
# see docs/security-boundaries.md. Leave all three blank to leave
# scheduled jobs disabled (reminders/expiry simply never fire; nothing
# else in the app depends on them).
SCHEDULER_SECRET=
SCHEDULER_SUPABASE_EMAIL=
SCHEDULER_SUPABASE_PASSWORD=
