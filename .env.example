# Copy this file to .env.local and fill in real values from your Supabase
# project settings (Project Settings -> API). Never commit .env.local or
# any file containing real secrets — .gitignore already excludes .env*.
#
# The public marketing site renders without any of these being set. They
# are only required to exercise sign-up/sign-in, onboarding, and the
# dashboard against a real backend.

# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings -> API -> Project API keys -> anon / public
# Safe to expose to the browser. Row Level Security is what actually
# protects data behind this key — see docs/security-boundaries.md.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The public URL this app is deployed at (used for auth redirect links).
# For local development:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Project Settings -> API -> Project API keys -> service_role
# SERVER-ONLY. Never reference this from a client component or anything
# bundled into browser code. Not used anywhere in the Phase 1 codebase —
# reserved for future trusted server-side tooling only.
SUPABASE_SERVICE_ROLE_KEY=
